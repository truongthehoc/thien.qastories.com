{
  "name": "thien-vien-sanctuary",
  "version": "1.0.0",
  "private": true,
  "description": "THIỀN VIÊN – Không gian an trú (Digital Meditation Sanctuary)",
  "scripts": {
    "start": "node start.js",
    "postinstall": "npm --prefix backend install --omit=dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:push": "npm --prefix backend run prisma:push",
    "db:seed": "npm --prefix backend run prisma:seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "@types/jpeg-js": "^0.3.0",
    "@types/pngjs": "^6.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  }
}
